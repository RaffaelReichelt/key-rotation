# Tailnet identifier (usually your tailnet domain)
# Example: example.com
TS_TAILNET=tail5a2ccd.ts.net

# OAuth client credentials from Tailscale "Trust credentials"
TS_OAUTH_CLIENT_ID=k7rBwZ96qk11CNTRL
TS_OAUTH_CLIENT_SECRET=tskey-client-k7rBwZ96qk11CNTRL-ke5jzjonNzf2yR78w1HkyfdU4Ybzrj9R6

# Name of the Docker Swarm secret that holds the auth key
SECRET_NAME=ts_authkey

# Auth key settings for automated rotation
# Reusable, because several sidecars share the secret
TS_KEY_DESCRIPTION=swarm-automated-rotation
TS_KEY_EXPIRY_SECONDS=2592000
TS_KEY_PREAUTHORIZED=true
TS_KEY_EPHEMERAL=false
TS_KEY_REUSABLE=true
TS_KEY_TAGS=tag:swarm
